  p.dswSpecificBubbleHighlight = '#43454A';
  p.dswSpecificBubble = '#2C2C2E';
  p.dswSpecificInputMajor = '#2C2C2E';
  p.dswSpecificLoginInput = '#1B1B1C';
  p.dswMenuSurfaceFill = 'rgba(67, 69, 74, 0.45)';
  p.dswSpecificMenu = 'rgba(67, 69, 74, 0.45)';
  p.dswSpecificSelector = '#353638';
  p.dswSpecificSidebarFill = '#1B1B1C';
  p.dswSpecificSidebarNavItemActiveAccent = '#353638';
  p.dswSpecificSidebarNavItemActive = '#43454A';
  p.dswSpecificSidebarNavItemHover = '#2C2C2E';
  p.dswSpecificTip = '#353638';
  return p;
}

